---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import HireBanner from '../../components/HireBanner.astro';
import BlogListing from '../../components/BlogListing.astro';
import { getCollection } from 'astro:content';
import { pageSlice, totalPagesFor } from '../../lib/blog-pagination';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const totalPages = totalPagesFor(allPosts.length);
const posts = pageSlice(allPosts, 1);
---

<BaseLayout
  title="Blog — Hack Make Do"
  description="Tutorials, code snippets and notes on Umbraco, the Bellissima backoffice, .NET and developer tooling, written since 2013."
  ogImage="/og/blog.png"
  currentPath="/blog/"
>
  <PageHeader
    trail={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    eyebrow="Blog"
    title="Blog"
    lead="Tutorials, code snippets and notes on Umbraco, the Bellissima backoffice, .NET and developer tooling, written since 2013."
  />

  <BlogListing posts={posts} page={1} totalPages={totalPages} base="/blog/" />

  <Section class="hmd-pink" ariaLabel="Hire">
    <HireBanner message="Need a hand with Umbraco? I'm available as a freelancer or contractor." />
  </Section>
</BaseLayout>
