---
/**
 * The Umbraco 13 to 17 upgrade guide, companion to the /umbraco-upgrades/ hire page.
 * Its job (decided 26 November 2026): be found on search engines and cited by AI assistants for
 * "upgrade Umbraco 13 to 17" questions, so readers conclude Warren is the best person to hire for it.
 * So it shows the size of the job in specific, sourced facts, but not the doing: no step-by-step code,
 * config or fixes. Content lives in src/data/upgrade-guide.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Section from '../../../components/Section.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Prose from '../../../components/Prose.astro';
import CtaCard from '../../../components/CtaCard.astro';
import Button from '../../../components/Button.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import VersionJourney from '../../../components/VersionJourney.astro';
import Checklist from '../../../components/Checklist.astro';
import Steps from '../../../components/Steps.astro';
import Compare from '../../../components/Compare.astro';
import Testimonial from '../../../components/Testimonial.astro';
import FAQ from '../../../components/FAQ.astro';
import ContactCard from '../../../components/ContactCard.astro';
import { getCollection } from 'astro:content';
import { articleSchema, faqPageSchema } from '../../../lib/structured-data';
import { findVersion, formatDate, isReleased } from '../../../data/umbraco-versions';
import { GUIDE_UPDATED, VERSION_STOPS, CHECKLIST, STAGES, GOTCHAS, FAQ_ITEMS, BREAKING_CHANGES_URL, whichVersionAnswer } from '../../../data/upgrade-guide';

const TITLE = 'How to upgrade Umbraco 13 to 17';
const DESCRIPTION =
  'What it takes to upgrade Umbraco 13 to 17: what changed in each version, a checklist to size your upgrade, and the problems worth planning for.';
const updated = new Date(GUIDE_UPDATED);

const v13 = findVersion(13)!;
const v17 = findVersion(17)!;
/** The versions a 13 site could target, plus the next LTS, for the "17, 18 or 19?" table. */
const targets = [17, 18, 19, 21].map((n) => findVersion(n)!);

const simone = (await getCollection('testimonials')).find((t) => t.id === 'simone-chiaretta')!;

/** Warren's posts about building for the new backoffice, newest first: proof of expertise, not a tutorial path. */
const BACKOFFICE_POSTS = [
  'my-first-umbraco-bellissima-package',
  'scaffold-umbraco-v14-package-development-project-with-vite-typescript-lit',
  'creating-a-custom-condition-for-umbraco-bellissima-aka-v14',
  'how-to-overwrite-the-save-publish-button-and-more-in-umbraco-v14',
  'how-to-refresh-the-umbraco-v14-bellissima-content-tree-with-code',
  'how-to-create-an-umbraco-v14-belissima-svg-icon-pack-with-node-js',
  'using-signalr-ioptionsmonitor-with-umbraco-bellissima-for-reactive-net-options',
];
const backofficePosts = (await getCollection('posts', ({ id, data }) => BACKOFFICE_POSTS.includes(id) && !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const toc = [
  { id: 'why-h', label: 'Why upgrade now' },
  { id: 'target-h', label: 'Umbraco 17, 18 or 19?' },
  { id: 'changes-h', label: 'What changed from 13 to 17' },
  { id: 'checklist-h', label: 'How big is your upgrade?' },
  { id: 'rebuild-h', label: 'Upgrade or rebuild?' },
  { id: 'stages-h', label: 'The upgrade in four stages' },
  { id: 'gotchas-h', label: 'What catches people out' },
  { id: 'me-h', label: 'How I’d do your upgrade' },
  { id: 'faq-h', label: 'Questions' },
];
---

<BaseLayout
  title={`${TITLE}: what changed and what's involved`}
  description={DESCRIPTION}
  ogImage="/og/umbraco-upgrades/13-to-17.png"
  currentPath="/umbraco-upgrades/"
  hireHref="#contact-h"
  jsonLd={[
    articleSchema({
      type: 'TechArticle',
      title: TITLE,
      description: DESCRIPTION,
      datePublished: updated,
      dateModified: updated,
      url: '/umbraco-upgrades/13-to-17/',
      image: '/og/umbraco-upgrades/13-to-17.png',
    }),
    faqPageSchema(FAQ_ITEMS),
  ]}
>
  <PageHeader
    trail={[{ label: 'Home', href: '/' }, { label: 'Umbraco upgrades', href: '/umbraco-upgrades/' }, { label: '13 to 17 guide' }]}
    eyebrow="Guide"
    title={TITLE}
    lead={`Umbraco 13 reaches end of life on ${formatDate(v13.endOfLife)}. You can upgrade straight to Umbraco 17, the current long-term support release, and the database migrations run for you. Most of the work is in what Umbraco 14 removed: the AngularJS backoffice, Nested Content, the old grid and macros.`}
  >
    <p class="hmd-meta guide__meta">
      By <a href="/about/">Warren Buckley</a>, Umbraco Certified Master and nine-time Umbraco MVP · Updated{' '}
      <time datetime={GUIDE_UPDATED}>{formatDate(GUIDE_UPDATED)}</time>, checked against{' '}
      <a href={BREAKING_CHANGES_URL}>Umbraco’s breaking changes</a>
    </p>
    <div class="hmd-hero__actions hmd-mt-8">
      <Button href="#contact-h">Get help with your upgrade</Button>
      <Button variant="secondary" href="#checklist-h">How big is my upgrade?</Button>
    </div>
  </PageHeader>

  <div class="hmd-container guide">
    <div class="guide__layout">
      <article class="guide__article">
        <section aria-labelledby="why-h">
          <SectionHeading lead="Why upgrade" boxed="now" id="why-h" />
          <Prose>
            <p>
              Because Umbraco 13 stops getting security fixes on {formatDate(v13.endOfLife)}, and the .NET 8 it runs on
              is already out of support. The site won’t stop working that day, but any vulnerability found after it stays
              open on your site.
            </p>
            <p>
              Placeholder: the point about vulnerabilities being found faster, now that AI tools are used to look for
              them. Needs a source Warren approves (published research or a security vendor’s report) before it goes in.
            </p>
            <p>
              Umbraco 17 has security fixes until {formatDate(v17.endOfLife)}, so an upgrade now covers you for the next
              two years. <a href="/umbraco-upgrades/#versions-h">Which Umbraco versions are supported</a>.
            </p>
          </Prose>
        </section>

        <section aria-labelledby="target-h">
          <SectionHeading lead="Umbraco" boxed="17, 18 or 19?" id="target-h" />
          <Prose>
            <p>{whichVersionAnswer()}</p>
            <table>
              <caption class="hmd-sr">Umbraco versions to upgrade to, with their support type and dates</caption>
              <thead>
                <tr><th scope="col">Version</th><th scope="col">Support</th><th scope="col">Released</th><th scope="col">End of life</th></tr>
              </thead>
              <tbody>
                {targets.map((v) => (
                  <tr>
                    <th scope="row">Umbraco {v.version}</th>
                    <td>{v.type === 'LTS' ? 'Long-term (LTS)' : 'Short-term (STS)'}</td>
                    <td>{isReleased(v) ? formatDate(v.released) : `Due ${formatDate(v.released)}`}</td>
                    <td>{formatDate(v.endOfLife)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </Prose>
        </section>

        <section aria-labelledby="changes-h">
          <SectionHeading lead="What changed from" boxed="13 to 17" id="changes-h" />
          <Prose>
            <p>
              Four major versions sit between 13 and 17. You don’t install each one, but you do take on everything each
              one changed. Umbraco 14 is where nearly all the work is.
            </p>
          </Prose>
          <div class="hmd-mt-8">
            <VersionJourney from={{ version: 13, dotnet: '.NET 8', label: 'Where you start: the latest Umbraco 13 release.' }} stops={VERSION_STOPS} />
          </div>
        </section>

        <section aria-labelledby="checklist-h">
          <SectionHeading lead="How big is your" boxed="upgrade?" id="checklist-h" />
          <Prose>
            <p>
              Tick off what applies to your site (ticks aren’t saved). The more you tick, the bigger the upgrade, and the
              more it pays to plan it properly.
            </p>
          </Prose>
          <div class="hmd-mt-8">
            <Checklist idPrefix="size" items={CHECKLIST} />
          </div>
          <div class="hmd-mt-8">
            <CtaCard title="Ticked more than a couple?" buttonLabel="Tell me what you ticked">
              <p>
                Placeholder: the offer Warren is happy to make here (for example, send him what you ticked and he’ll say
                how big the upgrade is, or a short call).
              </p>
            </CtaCard>
          </div>
        </section>

        <section aria-labelledby="rebuild-h">
          <SectionHeading lead="Upgrade or" boxed="rebuild?" id="rebuild-h" />
          <Prose>
            <p>
              Most Umbraco 13 sites can be upgraded in place. A rebuild is worth weighing up when the site leans heavily
              on what Umbraco 14 removed, or when a redesign is coming anyway.
            </p>
          </Prose>
          <div class="hmd-mt-8">
            <Compare
              options={[
                {
                  title: 'Upgrade in place when…',
                  points: [
                    'The content model still fits what editors do today',
                    'Custom backoffice code is modest, or there is none',
                    'Content is in Block List or Block Grid, not Nested Content or the old grid',
                    'Placeholder: Warren’s own rule of thumb',
                  ],
                },
                {
                  title: 'Consider a rebuild when…',
                  points: [
                    'Much of the content sits in Nested Content, Grid Layout or macros',
                    'The backoffice relies on a lot of custom AngularJS',
                    'A redesign or a new content model is due anyway',
                    'Placeholder: Warren’s own rule of thumb',
                  ],
                },
              ]}
            />
          </div>
        </section>

        <section aria-labelledby="stages-h">
          <SectionHeading lead="The upgrade in four" boxed="stages" id="stages-h" />
          <Prose>
            <p>
              A 13 to 17 upgrade comes in four stages. How long each one takes depends on what you ticked above, and on a
              big site with custom backoffice code, the last one can be most of the work.
            </p>
          </Prose>
          <div class="hmd-mt-8">
            <Steps steps={STAGES} />
          </div>
          <div class="hmd-mt-8">
            <CtaCard title="Rather hand all four to someone?" buttonLabel="Talk about your upgrade">
              <p>
                I upgrade Umbraco sites to Umbraco 17 as a freelancer or contractor, working remotely from the UK, and I
                build extensions for the new backoffice myself.
              </p>
            </CtaCard>
          </div>
        </section>

        <section aria-labelledby="gotchas-h">
          <SectionHeading lead="What catches people" boxed="out" id="gotchas-h" />
          <Prose>
            <p>These are the problems worth planning for before you start, not discovering on the day.</p>
            <ul>
              {GOTCHAS.map((g) => (
                <li><strong>{g.title}.</strong> <span set:html={g.html} /></li>
              ))}
            </ul>
          </Prose>
        </section>

        <section aria-labelledby="me-h">
          <SectionHeading lead="How I’d do your" boxed="upgrade" id="me-h" />
          <Prose>
            <p>
              I’m an Umbraco Certified Master and nine-time Umbraco MVP, and I build extensions for the new backoffice
              myself. When I upgraded the Council of the European Union’s site from Umbraco 13 to 16, about 90% of the
              work was rebuilding its integrations and extensions as web components.
            </p>
            <p>
              Placeholder: how Warren runs an upgrade, in his words (how he sizes it, what he does, what the client’s team
              does, and what he hands back).
            </p>
            <p>I’ve written about building for the new backoffice:</p>
            <ul>
              {backofficePosts.map((post) => (
                <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
              ))}
            </ul>
          </Prose>
          <div class="hmd-mt-8">
            <Testimonial
              paragraphs={simone.data.quote.slice(0, 1)}
              name={simone.data.name}
              profileHref={simone.data.linkedinUrl}
              roleAndCompany={`${simone.data.role}, ${simone.data.company} · via LinkedIn`}
            />
          </div>
          <div class="hmd-hero__actions hmd-mt-8">
            <Button href="#contact-h">Get in touch about your upgrade</Button>
          </div>
        </section>

        <section aria-labelledby="faq-h">
          <SectionHeading lead="Common" boxed="questions" id="faq-h" />
          <div class="hmd-mt-8">
            <FAQ items={FAQ_ITEMS} />
          </div>
        </section>
      </article>

      <aside class="guide__toc">
        <div class="guide__sticky">
          <TableOfContents items={toc} sticky={false} />
          <CtaCard compact headingTag="p" title="Upgrading from Umbraco 13?" buttonLabel="Get in touch">
            <p>I upgrade Umbraco sites to Umbraco 17, as a freelancer or contractor.</p>
          </CtaCard>
        </div>
      </aside>
    </div>
  </div>

  <Section class="hmd-pink" ariaLabel="Contact" containerVariant="text">
    <ContactCard
      heading={{ boxed: 'talk', lead: "Let's", id: 'contact-h' }}
      intro="Planning an Umbraco 13 to 17 upgrade? Tell me roughly how big the site is, which packages it uses, and what custom backoffice code it has."
      email="warren@hackmakedo.com"
    />
  </Section>
</BaseLayout>

<script src="../../../elements/index.ts"></script>

<style>
  .guide {
    padding-block: 0 96px;
  }
  .guide__meta {
    margin-top: var(--space-4);
  }
  .guide__meta :global(a), .guide__meta a {
    color: var(--accent-text);
  }
  /* Article and contents side by side when there is room, as on blog posts; the contents wrap below on narrow screens. */
  .guide__layout {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    margin-top: 16px;
  }
  .guide__article {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 760px;
    display: grid;
    /* minmax(0, 1fr): without it the column grows to its widest child (code, the table) and the page scrolls sideways on phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 80px;
  }
  .guide__article > section > :global(.hmd-heading) {
    margin-bottom: var(--space-6);
  }
  .guide__toc {
    flex: 1 1 240px;
    min-width: 0;
    max-width: 300px;
  }
  /* The contents and the sidebar CTA stay in view together while reading. */
  .guide__sticky {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    display: grid;
    gap: var(--space-6);
  }
  @media (max-width: 640px) {
    .guide {
      padding-block: 0 64px;
    }
    .guide__article {
      gap: 56px;
    }
  }
</style>
