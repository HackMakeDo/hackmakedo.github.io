---
import { Image } from 'astro:assets';
import { mvpBadge } from '../lib/mvp-badges';
import { CERTIFICATION } from '../data/certification';
/**
 * The proof strip: checkable numbers, the current year's official Umbraco MVP badge shown
 * large, and the Umbraco Certified Master badge beside it. Per the decided brief (not the
 * original design-system preview): one MVP badge, not a row of all nine — the full row lives
 * on the Timeline instead.
 */
interface Stat {
  label: string;
  value: string;
}
interface Badge {
  year: number;
}
interface Props {
  heading: string;
  stats: Stat[];
  badge: Badge;
  timelineHref?: string;
  timelineLabel?: string;
}
const { heading, stats, badge, timelineHref = '/timeline/', timelineLabel = 'See the full timeline' } = Astro.props;
---

<div class="hmd-creds">
  <div class="hmd-creds__main">
    <p class="display-lg">{heading}</p>
    <dl class="hmd-stats">
      {stats.map((stat) => (
        <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
      ))}
    </dl>
    <a class="hmd-link" href={timelineHref}>{timelineLabel}</a>
  </div>
  <div class="hmd-creds__badges">
    <Image
      src={mvpBadge(badge.year)}
      alt={`Official Umbraco MVP ${badge.year} badge`}
      width={200}
      height={200}
      densities={[1, 2]}
      format="webp"
      class="hmd-creds__badge"
    />
    <Image
      src={CERTIFICATION.badge}
      alt={`${CERTIFICATION.name} badge`}
      width={191}
      height={200}
      densities={[1, 2]}
      format="webp"
      class="hmd-creds__badge hmd-creds__badge--cert"
    />
  </div>
</div>

<style>
  .hmd-creds {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-12, 48px);
  }
  .hmd-creds__main {
    display: grid;
    gap: var(--space-6, 24px);
    flex: 1 1 520px;
    min-width: 0;
  }
  .display-lg {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hmd-creds__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6, 24px);
  }
  .hmd-creds__badge {
    display: block;
    width: 200px;
    height: 200px;
    flex: none;
  }
  .hmd-creds__badge--cert {
    width: 191px;
  }
  /* Two 200px badges don't fit side by side on a phone: shrink both rather than stack them. */
  @media (max-width: 480px) {
    .hmd-creds__badge {
      width: 140px;
      height: 140px;
    }
    .hmd-creds__badge--cert {
      width: 134px;
    }
  }
</style>
